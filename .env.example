# Copy this file to .env and replace the placeholder values.
# Never commit .env or put real keys in this file.

# Required for GitHub API access. A fine-grained token with repository
# metadata and contents read access is sufficient for public repositories.
GITHUB_TOKEN=

# Configure Gemini as the primary LLM provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional fallback provider. Leave blank if it is not needed.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-coder
